{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "game.schema.json",
  "title": "MAIPA portfolio — tryb gry (data/game.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_info": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "description": "false = wyłącz tryb gry i przycisk GRAJ."
    },
    "sound": {
      "type": "boolean"
    },
    "pixelScale": {
      "type": "number",
      "description": "Powiększenie pikseli sprite'ów (4 = 16 px → 64 px)."
    },
    "defaultCharacter": {
      "type": "string",
      "description": "Id postaci z data/characters.json."
    },
    "player": {
      "type": "object",
      "description": "Domyślny układ klatek sprite'ów postaci.",
      "properties": {
        "frameWidth": {
          "type": "number"
        },
        "frameHeight": {
          "type": "number"
        },
        "hitbox": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            }
          }
        },
        "animations": {
          "type": "object",
          "description": "idle, run, jump, fall, wave, climb, wallslide → { frames: [...], fps }",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "frames": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "fps": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "collectible": {
      "type": "object"
    },
    "physics": {
      "type": "object",
      "properties": {
        "gravity": {
          "type": "number"
        },
        "moveSpeed": {
          "type": "number"
        },
        "jumpVelocity": {
          "type": "number"
        },
        "doubleJump": {
          "type": "boolean"
        },
        "maxFallSpeed": {
          "type": "number"
        },
        "wallSlideSpeed": {
          "type": "number"
        },
        "climbSpeed": {
          "type": "number"
        },
        "climbStamina": {
          "type": "number"
        },
        "wallJumpPush": {
          "type": "number"
        },
        "elementWalls": {
          "type": "boolean",
          "description": "true = boki elementów też są ścianami (domyślnie tylko boki strony)."
        }
      }
    },
    "car": {
      "type": "object",
      "description": "Sekretna gra z autem (runner) i garaż.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretAt": {
          "type": "string",
          "description": "Selektor elementu, w którym E uruchamia grę z autem."
        },
        "size": {
          "type": "object",
          "description": "Rozmiar sprite'a karoserii w px."
        },
        "hitbox": {
          "type": "object"
        },
        "wheelSize": {
          "type": "number",
          "description": "Rozmiar klatki koła w px (kwadrat)."
        },
        "wheelFrames": {
          "type": "integer",
          "description": "Liczba klatek obrotu koła (poziomy pasek)."
        },
        "wheelAnchors": {
          "type": "array",
          "description": "Lewy górny róg każdego koła na karoserii [x, y] w px sprite'a."
        },
        "speed": {
          "type": "number"
        },
        "speedUp": {
          "type": "number"
        },
        "maxSpeed": {
          "type": "number"
        },
        "gravity": {
          "type": "number"
        },
        "jumpVelocity": {
          "type": "number"
        },
        "slamSpeed": {
          "type": "number",
          "description": "Prędkość docisku do ziemi (↓)."
        },
        "rampVelocity": {
          "type": "number",
          "description": "Wybicie z rampy."
        },
        "bodies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "$ref": "common.schema.json#/definitions/text"
              },
              "sprite": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "description": "Waga ceny (0 = darmowe, posiadane od początku)."
              }
            }
          },
          "description": "Karoserie (bez kół)."
        },
        "wheels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "$ref": "common.schema.json#/definitions/text"
              },
              "sprite": {
                "type": "string",
                "description": "Poziomy pasek klatek obrotu koła."
              },
              "weight": {
                "type": "number"
              }
            }
          },
          "description": "Zestawy kół (wspólna animacja dla każdej karoserii)."
        },
        "upgrades": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "$ref": "common.schema.json#/definitions/text"
              },
              "description": {
                "$ref": "common.schema.json#/definitions/text"
              },
              "icon": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              }
            }
          },
          "description": "Tuning: springs | doubleJump | shield."
        },
        "obstacles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "$ref": "common.schema.json#/definitions/text"
              },
              "sprite": {
                "type": "string"
              },
              "frames": {
                "type": "integer"
              },
              "fps": {
                "type": "number"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ground",
                  "air",
                  "ramp"
                ],
                "description": "ground = przeskocz; air = lata nad drogą, dociśnij ↓; ramp = wybija w górę."
              },
              "chance": {
                "type": "number",
                "description": "Względna częstość."
              }
            }
          },
          "description": "Przeszkody (obrazki)."
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selektory CSS elementów, których górne krawędzie są platformami."
    },
    "coinsOn": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selektory CSS elementów, nad którymi pojawiają się monety w wyzwaniu."
    },
    "interact": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "open-project",
          "open-team",
          "back",
          "click",
          "select-character"
        ]
      },
      "description": "Selektor → akcja pod klawiszem E."
    }
  }
}
