{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "people.schema.json",
  "title": "MAIPA portfolio — osoby (data/people.json)",
  "type": "object", "required": ["people"],
  "properties": {
    "$schema": { "type": "string" },
    "people": { "type": "array", "items": {
      "type": "object", "required": ["id", "name"], "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/definitions/id", "description": "Id używane w zespołach i projektach." },
        "name": { "type": "string" },
        "me": { "type": "boolean", "description": "To ja — wyróżnienie na listach." },
        "avatar": { "$ref": "common.schema.json#/definitions/image" },
        "title": { "$ref": "common.schema.json#/definitions/text", "description": "Ogólna specjalizacja (np. Gameplay programmer)." },
        "links": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/link" } }
      }
    } }
  }
}
