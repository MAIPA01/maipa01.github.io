{
  "$schema": "../schemas/game.schema.json",
  "_info": "Play mode settings (press P). Texts: data/i18n/<lang>.json → \"game\". Playable characters: data/characters.json → \"game\". Levels = home + project pages (order of the cards). \"shop\": garage items; prices = weight / sum of weights × all coins that can be earned.",
  "enabled": true,
  "sound": true,
  "pixelScale": 4,
  "defaultCharacter": "maipa-chan",
  "player": {
    "frameWidth": 16,
    "frameHeight": 16,
    "hitbox": {
      "x": 3,
      "y": 0,
      "w": 11,
      "h": 16
    },
    "animations": {
      "idle": {
        "frames": [
          0,
          1
        ],
        "fps": 2
      },
      "run": {
        "frames": [
          2,
          3,
          4,
          5
        ],
        "fps": 10
      },
      "jump": {
        "frames": [
          6
        ],
        "fps": 1
      },
      "fall": {
        "frames": [
          7
        ],
        "fps": 1
      },
      "wave": {
        "frames": [
          8,
          9
        ],
        "fps": 5
      },
      "climb": {
        "frames": [
          10,
          11
        ],
        "fps": 6
      },
      "wallslide": {
        "frames": [
          12
        ],
        "fps": 1
      }
    }
  },
  "collectible": {
    "sprite": "assets/game/coin.png",
    "frameWidth": 8,
    "frameHeight": 8,
    "frames": [
      0,
      1,
      2,
      3,
      2,
      1
    ],
    "fps": 10
  },
  "physics": {
    "gravity": 2200,
    "moveSpeed": 340,
    "jumpVelocity": 820,
    "doubleJump": true,
    "maxFallSpeed": 1100,
    "wallSlideSpeed": 140,
    "climbSpeed": 170,
    "climbStamina": 4,
    "wallJumpPush": 360,
    "elementWalls": false
  },
  "car": {
    "enabled": true,
    "sprite": "assets/game/car.png",
    "frameWidth": 32,
    "frameHeight": 16,
    "frames": [
      0,
      1
    ],
    "secretAt": ".band-1",
    "speed": 430,
    "speedUp": 14,
    "maxSpeed": 1150,
    "jumpVelocity": 900,
    "slamSpeed": 1700
  },
  "shop": {
    "colorWeight": 1,
    "upgrades": [
      {
        "id": "springs",
        "weight": 2
      },
      {
        "id": "doubleJump",
        "weight": 3
      },
      {
        "id": "shield",
        "weight": 3
      }
    ]
  },
  "platforms": [
    ".section-head",
    ".skill-card",
    ".stat",
    ".about-avatar",
    ".filter-chip",
    ".project-card",
    ".model-tile",
    ".character-card",
    ".contact-text",
    ".social-link",
    ".site-footer",
    ".hero-actions .btn",
    ".hero-actions .btn-pixel",
    ".pp-head",
    ".pp-block",
    ".pp-gallery-item",
    ".pp-side-card",
    ".pp-back",
    ".nf-card",
    ".nf-digit",
    ".project-link",
    ".project-body",
    ".pp-team-head",
    ".tp-member",
    ".pp-related-card",
    ".section"
  ],
  "coinsOn": [
    ".project-card",
    ".skill-card",
    ".model-tile",
    ".character-card",
    ".pp-block",
    ".pp-gallery-item",
    ".nf-card"
  ],
  "interact": {
    ".project-card": "open-project",
    ".model-tile": "open-project",
    ".pp-back": "back",
    ".social-link": "click",
    ".render-tile": "click",
    ".filter-chip": "click",
    ".pp-gallery-item": "click",
    ".character-card": "select-character",
    ".pp-team-head": "open-team",
    ".pp-related-card": "open-project"
  }
}
